# ========================================
# ARCHIVO DE CONFIGURACIÓN DEL PROYECTO
# ========================================
# Opcional: si no existe .env, docker compose usa los valores por defecto (neo4j / password).
# Para personalizar, copia este archivo como .env en la raíz del proyecto.
#
# Docker Compose solo lee estas dos variables; el resto de la configuración
# (URIs, puertos, colas de RabbitMQ) está fijada en docker-compose.yml.
#
# Notas:
# - Neo4j exige una contraseña de al menos 8 caracteres.
# - La contraseña solo se aplica la primera vez que se crea el volumen de Neo4j.
#   Si la cambias después, borra el volumen con: docker compose down -v
# - Nunca commitear .env a Git (contiene credenciales).

NEO4J_USER=neo4j
NEO4J_PASSWORD=password
