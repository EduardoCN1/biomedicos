# ========================================
# ARCHIVO DE CONFIGURACIÓN DEL PROYECTO
# ========================================
# Opcional: si no existe .env, docker compose usa los valores por defecto indicados abajo.
# Para personalizar, copia este archivo como .env en la raíz del proyecto.
#
# Docker Compose solo lee estas variables; el resto de la configuración
# (URIs, colas de RabbitMQ, demás puertos) está fijada en docker-compose.yml.
#
# Notas:
# - Neo4j exige una contraseña de al menos 8 caracteres.
# - La contraseña solo se aplica la primera vez que se crea el volumen de Neo4j.
#   Si la cambias después, borra el volumen con: docker compose down -v
# - Nunca commitear .env a Git (contiene credenciales).

NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Puerto del frontend en tu equipo (http://localhost:<puerto>).
# Cámbialo si otro programa ya usa el 5500.
FRONTEND_PORT=5500

# Puerto de la API en tu equipo, para pruebas directas (test-pipeline.ps1, docs/API.md).
# La página no lo usa: llama a la API a través del frontend (/api).
# Cámbialo si otro programa ya usa el 5000.
API_PORT=5000
