# ========================================
# ARCHIVO DE CONFIGURACIÓN DEL PROYECTO
# ========================================
# Instrucciones:
# 1. Copia este archivo como .env en la raiz del proyecto
# 2. Si usas Docker: Los valores por defecto funcionan perfecto
# 3. Si usas Local (sin Docker): Ajusta NEO4J_URI y RABBITMQ_URL a tu máquina
#
# Nota: Nunca commitear .env a Git (contiene credenciales)

# ========================================
# NEO4J (Base de datos)
# ========================================
# Para Docker: usa "neo4j" (nombre del servicio)
# Para Local:  usa "127.0.0.1"
NEO4J_URI=neo4j://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ========================================
# API SERVER
# ========================================
HOST=0.0.0.0
PORT=5000

# Modo ejecución
ENVIRONMENT=development

# ========================================
# RABBITMQ (Message Broker)
# ========================================
# Para Docker: usa "rabbitmq" (nombre del servicio)
# Para Local:  usa "localhost"
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/%2F

# ========================================
# COLAS DE RABBITMQ
# ========================================
RECOMMENDATION_REQUEST_QUEUE=tnm.recommendation.request
VALIDATION_REQUEST_QUEUE=tnm.validation.request
VALIDATION_RESULT_QUEUE=tnm.validation.result
RESPONSE_QUEUE=tnm.response

# ========================================
# MICROSERVICIOS
# ========================================
RECOMMENDER_HOST=recommender
RECOMMENDER_PORT=5001
VALIDATOR_HOST=ml-validator
VALIDATOR_PORT=5002

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=INFO
